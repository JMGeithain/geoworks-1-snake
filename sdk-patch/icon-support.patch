+package PCGEOS::Ensemble12::Icons;
+use strict;
+use warnings;
+use Exporter 'import';
+our @EXPORT_OK=qw(parse_art icon_variants);
+# Layout of the six moniker variants observed in an owned 1.x application:
+# [list entry type, width, height, kind]; kind c = 4-bit colour + mask, m = 1-bit.
+my @VARIANTS=([0x20c6,64,40,'c'],[0x20c1,64,40,'m'],[0x10c6,48,30,'c'],[0x10c1,48,30,'m'],[0x20e1,64,18,'m'],[0x10e1,48,14,'m']);
+# '.' transparent; k0 b1 d2 c3 R4 m5 o6 l7 g8 B9 G10 C11 r12 M13 y14 w15 (EGA indexes)
+my %COLOR=(k=>0,b=>1,d=>2,c=>3,R=>4,m=>5,o=>6,l=>7,g=>8,B=>9,G=>10,C=>11,r=>12,M=>13,y=>14,w=>15);
+sub parse_art {
+    my $text=shift;my @rows=grep {length} map {s/\s+$//r} split /\n/,$text;die "Icon art needs 2..64 rows\n" if @rows<2||@rows>64;
+    my $w=length($rows[0]);die "Icon art needs 2..64 columns\n" if $w<2||$w>64;
+    for my $r (@rows) {die "All icon art rows must have the same length\n" if length($r)!=$w;for my $c (split //,$r) {die "Unknown icon art character '$c'\n" unless $c eq '.'||exists $COLOR{$c}}}
+    return \@rows;
+}
+sub _cell {my ($art,$x,$y,$w,$h)=@_;my $rows=@$art;my $cols=length($art->[0]);return substr($art->[int(($y+0.5)*$rows/$h)],int(($x+0.5)*$cols/$w),1)}
+sub _row {my $d=shift;my $o='';for (my $i=0;$i<length($d);$i+=128) {my $n=length($d)-$i;$n=128 if $n>128;$o.=pack('C',$n-1).substr($d,$i,$n)}return $o}
+sub _moniker {
+    my ($art,$type,$w,$h,$kind)=@_;my $bytes=int(($w+7)/8);my $rows='';
+    for my $y (0..$h-1) {
+        if ($kind eq 'c') {
+            my @bits=(0) x $bytes;my $pix='';my @nib;
+            for my $x (0..$w-1) {my $c=_cell($art,$x,$y,$w,$h);my $on=$c ne '.';$bits[int($x/8)]|=0x80>>($x%8) if $on;push @nib,$on?$COLOR{$c}:0}
+            push @nib,0 if @nib%2;$pix.=pack('C',($nib[$_]<<4)|$nib[$_+1]) for grep {!($_%2)} 0..$#nib;
+            $rows.=_row(pack('C*',@bits))._row($pix);
+        } else {
+            my @bits=(0) x $bytes;
+            for my $x (0..$w-1) {my $c=_cell($art,$x,$y,$w,$h);my $black=($c eq 'g'||$c eq 'G'||$c eq 'd'||$c eq 'y'||$c eq 'b'||$c eq 'R'||($c eq 'r'&&(($x+$y)%2==0)));$bits[int($x/8)]|=0x80>>($x%8) if $black}
+            $rows.=_row(pack('C*',@bits));
+        }
+    }
+    my $bitmap=pack('vvCC',$w,$h,1,$kind eq 'c'?0x11:0).$rows;
+    return pack('CvCC',($type&0xff)&0x7f,$w,$h,0).pack('Cv',0x1a,length($bitmap)).$bitmap."\0";
+}
+sub icon_variants {my $art=shift;return map {[$_->[0],_moniker($art,@$_)]} @VARIANTS}
+1;
